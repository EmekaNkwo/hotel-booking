# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# `.env` is loaded automatically in dev; prod uses real environment variables.
#
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Ports 5432/6379 are occupied on this machine by a local "powergrid" Docker
# stack, so our services use 5433 (Postgres) and 6380 (Redis). Revert to
# 5432/6379 when that stack is stopped.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/hotel_booking
DB_CONN_MAX_AGE=60

REDIS_URL=redis://localhost:6380/0

# MFA (M2.5): Fernet key encrypting TOTP secrets at rest (base64, 32 bytes).
# Required before any MFA use — missing/invalid fails closed. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_FERNET_KEY=

# Half-authenticated (password ok, MFA pending) session window, seconds.
MFA_PENDING_TIMEOUT_SECONDS=600

# Display name shown as the "issuer" in the TOTP provisioning URI.
MFA_ISSUER=Hotel Booking

# Brute-force bound (per IP) for the MFA-code completion endpoint.
AUTH_MFA_THROTTLE_RATE=10/min
