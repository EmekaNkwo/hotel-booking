# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# `.env` is loaded automatically in dev; prod uses real environment variables.
#
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Ports 5432/6379 are occupied on this machine by a local "powergrid" Docker
# stack, so our services use 5433 (Postgres) and 6380 (Redis). Revert to
# 5432/6379 when that stack is stopped.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/hotel_booking
DB_CONN_MAX_AGE=60

REDIS_URL=redis://localhost:6380/0
